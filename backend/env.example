# Database Connection
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=generate-with-crypto-randomBytes-64
KEY_PASSPHRASE=your-key-encryption-passphrase

# CORS - Comma-separated frontend URLs
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# App Settings (Optional - defaults in code)
DEADLINE_DATE=2025-10-24T23:59:59

